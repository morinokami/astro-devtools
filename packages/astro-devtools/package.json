{
  "name": "astro-devtools",
  "version": "0.0.1",
  "description": "Astro integration for Vite DevTools: enables the DevTools host in Astro dev and adds Astro panels (overview, islands, routes, actions, config, docs) and a read-only MCP endpoint for coding agents",
  "keywords": [
    "astro",
    "astro-integration",
    "devtools",
    "vite",
    "withastro"
  ],
  "homepage": "https://github.com/morinokami/astro-devtools#readme",
  "bugs": {
    "url": "https://github.com/morinokami/astro-devtools/issues"
  },
  "license": "MIT",
  "author": "Shinya Fujino <shf0811@gmail.com> (https://github.com/morinokami)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/morinokami/astro-devtools.git",
    "directory": "packages/astro-devtools"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./client": "./dist/client.mjs",
    "./inject": "./dist/inject.mjs",
    "./kit": "./dist/kit.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@devframes/agentic": "catalog:devtools",
    "@devframes/vite": "catalog:devtools",
    "devframe": "catalog:devtools"
  },
  "devDependencies": {
    "@astro-devtools/ui": "workspace:*",
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/devtools": "catalog:devtools",
    "@vitejs/devtools-kit": "catalog:devtools",
    "astro": "catalog:",
    "cn": "catalog:",
    "devalue": "catalog:",
    "es-module-lexer": "catalog:",
    "happy-dom": "catalog:",
    "magic-string": "catalog:",
    "postcss": "catalog:",
    "preact": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@vitejs/devtools": "^0.7.5",
    "@vitejs/devtools-kit": "^0.7.5",
    "astro": "^7.0.0"
  },
  "inlinedDependencies": {
    "@jridgewell/sourcemap-codec": "1.6.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.3.0",
    "devalue": "5.9.2",
    "es-module-lexer": "3.0.2",
    "magic-string": "1.4.1",
    "preact": "10.29.8"
  }
}
