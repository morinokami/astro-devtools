{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // Agent skills ship their own scripts (a verification harness); they are
  // not part of any package graph, so knip lists them as unused files.
  // `ignoreFiles` hides only that one report; `ignore` would also hide real
  // issues, like a missing dependency, if a script is ever imported.
  "ignoreFiles": [".agents/**"],
  // Circular imports are opt-in and only a warning by default. The `knip`
  // script checks them in a separate pass (`knip --cycles`) because listing
  // them in `include` would replace knip's default issue types, and a type a
  // later knip adds would then silently go unchecked.
  "rules": { "cycles": "error" },
  "workspaces": {
    ".": {
      "ignoreDependencies": ["@vitejs/devtools", "pkg-pr-new", "vite", "vitest"],
    },
    "packages/astro-devtools": {
      "entry": ["src/{index,client,inject,kit}.ts"],
    },
    // The design system is private and bundled into astro-devtools, its only
    // consumer, so the exports of its entry files are not a public API:
    // report one that no panel imports, even when src/index.ts re-exports it.
    "packages/ui": {
      "includeEntryExports": true,
    },
    "playground": {
      "entry": ["e2e/auth.setup.ts", "e2e/support/start-server.ts"],
    },
  },
}
